{
    "include": [
        "src/**/*"
    ],
    "compilerOptions": {
        "target": "ES2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "declaration": true,
        "rootDir": "src",
        "outDir": "build",
        "sourceMap": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": true,
        "skipLibCheck": true,
        "types": ["node"]
    }
}
