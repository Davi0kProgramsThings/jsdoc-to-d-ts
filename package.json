{
    "name": "jsdoc-to-d-ts",
    "version": "1.0.0-alpha.1",
    "description": "Lightweight transpiler to convert javascript with jsdoc to typescript's .d.ts files.",
    "author": {
        "name": "Davide Casale",
        "email": "davi0kprogramsthings@gmail.com",
        "url": "https://github.com/davi0kprogramsthings"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/davi0kprogramsthings/jsdoc-to-d-ts.git"
    },
    "bugs": {
        "url": "https://github.com/davi0kprogramsthings/jsdoc-to-d-ts/issues"
    },
    "homepage": "https://github.com/davi0kprogramsthings/jsdoc-to-d-ts#readme",
    "license": "MIT",
    "main": "build/index.js",
    "type": "module",
    "types": "build/index.d.ts",
    "bin": {
        "jsdoc-to-d-ts": "build/bin/jsdoc-to-d-ts.js"
    },
    "scripts": {
        "prepare": "npm run build",
        "build": "tsc",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
    },
    "dependencies": {
        "commander": "15.0.0",
        "confbox": "0.2.4",
        "fast-glob": "3.3.3",
        "handlebars": "4.7.9",
        "ohm-js": "17.5.0",
        "pkg-types": "2.3.1"
    },
    "devDependencies": {
        "@babel/preset-env": "7.29.14",
        "@babel/preset-typescript": "7.29.7",
        "@jest/globals": "30.5.2",
        "@types/node": "26.2.0",
        "jest": "30.5.2",
        "typescript": "7.0.2"
    },
    "jest": {
        "extensionsToTreatAsEsm": [
            ".ts"
        ]
    },
    "babel": {
        "presets": [
            [ "@babel/preset-env", { "targets": { "node": "current" } } ],
            "@babel/preset-typescript"
        ]
    }
}
