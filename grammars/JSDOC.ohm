JSDOC {
    DocComment = "/**" Body "*/"
    
    Body = (Tag | ~"*/" any)*

    Tag = TagWithZeroArguments | TagWithOneArgument | TagWithTwoArguments | TagWithThreeArguments

    TagWithZeroArguments = "@internal"
                         | "@interface"
                         | "@abstract"
                         | "@protected"
                         | "@private"

    TagWithOneArgument = "@implements" TypeInBraces
                       | "@returns" TypeInBraces

    TagWithTwoArguments = "@param" TypeInBraces id
                        | "@typedef" TypeInBraces id
    
    TagWithThreeArguments = "@property" TypeInBraces id description

    TypeInBraces = "{" (~"}" any)* "}"

    id = (letter | "_" | "$") (letter | digit | "_" | "$")*

    description = (~"@" ~"*/" any)*
}
