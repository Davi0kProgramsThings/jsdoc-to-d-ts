JSDOC {
    DocComment = "/**" Body "*/"
    
    Body = (Tag | ~"*/" any)*

    Tag = TagWithZeroArguments | TagWithOneArgument | TagWithTwoArguments | TagWithThreeArguments | Template

    TagWithZeroArguments = "@internal"
                         | "@interface"
                         | "@abstract"
                         | "@protected"
                         | "@private"
                         | "@overload"

    TagWithOneArgument = "@implements" TypeInBraces
                       | "@type" TypeInBraces
                       | "@returns" TypeInBraces
                       | "@enum" TypeInBraces

    TagWithTwoArguments = "@param" TypeInBraces (id | optionalId)
                        | "@typedef" TypeInBraces IdWithAngleBrackets
    
    TagWithThreeArguments = "@property" TypeInBraces (id | optionalId) description

    Template = "@template" TypeInBraces? id                                          -- template
             | "@template" TypeInBraces? "[" id "=" (TypeInBrackets | ~"]" any)* "]" -- templateWithDefault

    TypeInBrackets = "[" (TypeInBrackets | ~"]" any)* "]"

    TypeInAngleBrackets = "<" (TypeInAngleBrackets | ~">" any)+ ">"

    TypeInBraces = "{" (TypeInBraces | ~"}" any)* "}"

    IdWithAngleBrackets = id TypeInAngleBrackets?

    id = (letter | "_" | "$") (letter | digit | "_" | "$")*

    optionalId = "[" id "]"

    description = (~"@" ~"*/" any)*
}
