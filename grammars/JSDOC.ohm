JSDOC {
    DocComment = "/**" Body "*/"
    Body = (Tag | ~"*/" any)*
    Tag = Internal | Interface | Abstract | Implements | Param | Returns
    Internal = "@internal"
    Interface = "@interface"
    Abstract = "@abstract"
    Implements = "@implements" TypeInBraces
    Param = "@param" TypeInBraces id
    Returns = "@returns" TypeInBraces
    TypeInBraces = "{" (~"}" any)* "}"
    id = (letter | "_" | "$") (letter | digit | "_" | "$")*
}
