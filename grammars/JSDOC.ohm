JSDOC {
    docComment = "/**" (tag | ~"*/" any)* "*/"

    tag = modifierTag
        | typeTag
        | enumTag
        | extendsTag
        | paramTag
        | propertyTag
        | typedefTag
        | templateTag
        | importTag

    modifierTag = "@" modifierTagName ~idPart

    modifierTagName = "internal"
                    | "interface"
                    | "abstract"
                    | "protected"
                    | "private"
                    | "overload"
                    | "readonly"

    typeTag = "@" typeTagName ~idPart blank typeExpression

    typeTagName = "implements"
                | "type"
                | "returns"
                | "return"

    enumTag = "@enum" ~idPart (blank typeExpression)?

    extendsTag = "@" extendsTagName ~idPart blank (typeExpression | typeReference)

    extendsTagName = "extends"
                   | "augments"

    paramTag = "@param" ~idPart blank typeExpression blank parameterName

    propertyTag = "@" propertyTagName ~idPart blank typeExpression blank parameterName blank description

    propertyTagName = "property"
                    | "prop"

    typedefTag = "@typedef" ~idPart blank typeExpression blank typedefName

    templateTag = "@template" ~idPart blank (typeExpression blank)? templateParameter (blank "," blank templateParameter)*

    templateParameter = "[" blank id blank "=" defaultValue "]" -- withDefault
                      | id                                      -- withoutDefault

    defaultValue = (squareBrackets | ~"]" any)*

    importTag = "@import" ~idPart multilineBlank importClause multilineBlank "from" ~idPart multilineBlank moduleName

    importClause = id multilineBlank "," multilineBlank namedImports -- defaultAndNamed
                 | "*" multilineBlank "as" ~idPart multilineBlank id  -- namespace
                 | namedImports                                       -- named
                 | id                                                 -- default

    namedImports = "{" multilineBlank importSpecifiers? multilineBlank ","? multilineBlank "}"

    importSpecifiers = importSpecifier (multilineBlank "," multilineBlank importSpecifier)*

    importSpecifier = id (multilineBlank "as" ~idPart multilineBlank id)?

    moduleName = "\"" (~"\"" any)* "\""
               | "'" (~"'" any)* "'"

    typeExpression = "{" (typeExpression | ~"}" any)* "}"

    parameterName = "[" blank qualifiedName blank ("=" defaultValue)? "]" -- optional
                  | qualifiedName                                         -- required

    qualifiedName = id ("[]"? "." id)*

    typedefName = id angleBrackets?

    typeReference = id ("." id)* angleBrackets?

    description = (~"@" ~"*/" any)*

    squareBrackets = "[" (squareBrackets | ~"]" any)* "]"

    angleBrackets = "<" (angleBrackets | ~">" any)+ ">"

    blank = (" " | "\t" | "\n" | "\r")*

    multilineBlank = (" " | "\t" | lineContinuation)*

    lineContinuation = ("\r\n" | "\n" | "\r") (" " | "\t")* ("*" ~"/")?

    id = idStart idPart*

    idStart = letter | "_" | "$"

    idPart = idStart | digit
}
