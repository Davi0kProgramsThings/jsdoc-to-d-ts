ES2022 <: JSDOC {
    File = (ImportStatement | ExportStatement | Component | any)*

    ImportStatement = "import" "{" ListOf<IdWithAlias, ","> "}" "from" String           -- import
                    | "import" id ("," "{" ListOf<IdWithAlias, ","> "}")? "from" String -- importWithDefault
                    | "import" "*" "as" id "from" String                                -- importWithWildcard

    ExportStatement = "export" "{" ListOf<IdWithAlias, ","> "}" "from" String 
                    | "export" "*" ("as" id)? "from" String

    Component = Class | Function | Constant | DocComment
    
    Constant = DocComment? "export"? Keyword id "=" Expr<(Component | ";")>   -- export
             | DocComment? "export" "default" id "=" Expr<(Component | ";")>  -- exportDefault
    Keyword = "var" | "let" | "const"

    Function = DocComment* Export? "async"? "function" id "(" ListOf<Argument, ","> ")" Block
    Block = "{" (Block | ~"}" any)* "}"

    Class = DocComment? Export? "class" id ("extends" id)? ClassBody
    ClassBody = "{" (Method | Get | Set | Member | ~"}" any)* "}"
    Member = DocComment? "static"? "#"? id
    Method = DocComment* "static"? "async"? "#"? id "(" ListOf<Argument, ","> ")" MethodBlock
    Get = DocComment? "get" "#"? id "(" ")" MethodBlock
    Set = DocComment? "set" "#"? id "(" id ")" MethodBlock
    MethodBlock = "{" (MemberDefinition | MethodBlock | ~"}" any)* "}"
    MemberDefinition = DocComment? "this" "." "#"? id "=" Expr<(MemberDefinition | MethodBlock | "}")>
    Export = "export" "default"?

    IdWithAlias = id ("as" id)?

    Argument = (id | ExprInBrackets) ("=" Expr<("," | ")")>)?

    Expr<stop> = (~stop (ExprInParenthesis | ExprInBrackets | String | any))+

    ExprInParenthesis = "(" (ExprInParenthesis | ExprInBrackets | String | (~")" any))+ ")"
    
    ExprInBrackets = "[" (ExprInParenthesis | ExprInBrackets | Comment | String | (~"]" any))+ "]"
                   | "{" (ExprInParenthesis | ExprInBrackets | Comment | String | (~"}" any))+ "}"

    String = "\"" (~"\"" any)* "\""
           | "\'" (~"\'" any)* "\'"
           | "`" (StringInterpolation | (~"`" any))* "`"

    StringInterpolation = "${" | Expr<"}"> | "}"

    Comment = "//" (~"\n" any)       -- lineComment
            | "/*" (~"*/" any)* "*/" -- multiLineComment
}
