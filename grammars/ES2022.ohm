ES2022 <: JSDOC {
    File = (ImportStatement | ExportStatement | Component | Atom)*

    ImportStatement = keyword<"import"> NamedImports keyword<"from"> string                       -- import
                    | keyword<"import"> id ("," NamedImports)? keyword<"from"> string             -- importWithDefault
                    | keyword<"import"> "*" keyword<"as"> id keyword<"from"> string                    -- importWithWildcard

    NamedImports = "{" ListOf<Specifier, ","> ","? "}"

    ExportStatement = keyword<"export"> NamedExports keyword<"from"> string                               -- exportFrom
                    | keyword<"export"> "*" (keyword<"as"> id)? keyword<"from"> string                         -- exportFromWithWildcard
                    | keyword<"export"> NamedExports                                                 -- export
                    | keyword<"export"> keyword<"default"> id ~(~#endOfStatement InitializerContinuation) -- exportDefault

    NamedExports = "{" ListOf<Specifier, ","> ","? "}"

    Specifier = id (keyword<"as"> id)?

    Component = Class | Function | Constant | docComment

    Export = keyword<"export"> keyword<"default">?

    Constant = docComment? keyword<"export">? VariableKind id "=" Initializer               -- declaration
             | docComment? keyword<"export"> keyword<"default"> id "=" Initializer               -- exportDefault
             | docComment? keyword<"export"> keyword<"default"> Initializer                      -- exportDefaultExpression

    VariableKind = keyword<"var"> | keyword<"let"> | keyword<"const">

    Function = docComment* Export? keyword<"async">? keyword<"function"> id? "(" Parameters ")" Block

    Class = docComment? Export? keyword<"class"> (~keyword<"extends"> id)? (keyword<"extends"> id)? ClassBody

    ClassBody = "{" (Method | Get | Set | StaticBlock | Member | Token)* "}"

    StaticBlock = keyword<"static"> MethodBlock

    Member = docComment? keyword<"static">? "#"? id ("=" Initializer)?

    Method = docComment* keyword<"static">? keyword<"async">? "#"? id "(" Parameters ")" MethodBlock

    Get = docComment? keyword<"static">? keyword<"get"> "#"? id "(" ")" MethodBlock

    Set = docComment? keyword<"static">? keyword<"set"> "#"? id "(" Parameter ")" MethodBlock

    MethodBlock = "{" (MemberDefinition | MethodBlock | ~"}" Atom)* "}"

    MemberDefinition = docComment? keyword<"this"> "." "#"? id "=" ~"=" &FunctionExpression -- function
                     | docComment? keyword<"this"> "." "#"? id "=" ~"="                     -- value

    Parameters = ListOf<Parameter, ",">

    Parameter = "..." (id | BindingPattern)             -- rest
              | (id | BindingPattern) ("=" Expression)? -- plain

    BindingPattern = "{" ListOf<ObjectBindingProperty, ","> ","? "}" -- object
                   | "[" ListOf<ArrayBindingElement, ","> ","? "]"   -- array

    ObjectBindingProperty = "..." id                                          -- rest
                          | id (":" (id | BindingPattern))? ("=" Expression)? -- property

    ArrayBindingElement = "..." (id | BindingPattern)             -- rest
                        | (id | BindingPattern) ("=" Expression)? -- element

    Expression = (~"," Token)+

    Initializer = ObjectLiteral ~(~#endOfStatement InitializerContinuation)   -- objectLiteral
                | FunctionExpression                                          -- functionExpression
                | Token (~#endOfStatement InitializerContinuation)*           -- expression

    FunctionExpression = keyword<"async">? keyword<"function"> id? "(" Parameters ")" Block ~(~#endOfStatement InitializerContinuation) -- function
                       | keyword<"async">? ArrowParameters "=>" ArrowBody                                                          -- arrow

    ArrowParameters = "(" Parameters ")" -- parenthesized
                    | id                 -- single

    ArrowBody = Block ~(~#endOfStatement InitializerContinuation) -- block
              | Initializer                                       -- expression

    ObjectLiteral = "{" ListOf<Property, ","> ","? "}"

    Property = docComment? (id | string) ":" Expression

    InitializerContinuation = #("++" | "--") &#endOfStatement -- postfix
                            | operator Token                  -- afterOperator
                            | ~";" Token                      -- token

    endOfStatement = (" " | "\t")* (lineTerminator | lineComment) space* (idStart | "#" | "/**")

    operator = operatorCharacter+
             | keyword<"new"> | keyword<"typeof"> | keyword<"instanceof"> | keyword<"in"> | keyword<"await">

    operatorCharacter = "+" | "-" | "*" | "/" ~("/" | "*") | "%" | "&" | "|" | "^" | "!" | "~"
                      | "<" | ">" | "=" | "?" | ":" | "," | "."

    Block = "{" Token* "}"

    Token = "(" Token* ")" division? -- parentheses
          | "[" Token* "]" division? -- squareBrackets
          | "{" Token* "}"           -- braces
          | ~closingBracket Atom

    Atom = string | templateLiteral | docComment | regexLiteral | Operand | any

    Operand = (~regexKeyword id | number | ")" | "]") division?

    regexKeyword = keyword<"return"> | keyword<"typeof"> | keyword<"case"> | keyword<"do"> | keyword<"else"> | keyword<"in"> | keyword<"of">
                 | keyword<"instanceof"> | keyword<"new"> | keyword<"delete"> | keyword<"void"> | keyword<"throw"> | keyword<"yield"> | keyword<"await">

    division = "/" ~("/" | "*")

    number = digit (idPart | decimal)*

    decimal = "." digit

    regexLiteral = "/" ~("/" | "*") regexCharacter+ "/" idPart*

    regexCharacter = regexClass
                   | regexEscape
                   | ~("/" | "[" | lineTerminator) any

    regexClass = "[" (regexEscape | ~("]" | lineTerminator) any)* "]"

    regexEscape = "\\" ~lineTerminator any

    closingBracket = ")" | "]" | "}"

    keyword<word> = word ~idPart

    string = "\"" (~"\"" ~lineTerminator stringCharacter)* "\""
           | "'" (~"'" ~lineTerminator stringCharacter)* "'"

    stringCharacter = "\\"? any

    templateLiteral = "`" (templateSubstitution | ~"`" stringCharacter)* "`"

    templateSubstitution = "${" templateSubstitutionContent* "}"

    templateSubstitutionContent = string
                                | templateLiteral
                                | comment
                                | docComment
                                | "{" templateSubstitutionContent* "}" -- braces
                                | ~"}" any                             -- any

    space += comment

    comment = lineComment | blockComment

    lineComment = "//" (~lineTerminator any)*

    blockComment = "/*" ~("*" ~"/") (~"*/" any)* "*/"

    lineTerminator = "\n" | "\r" | " " | " "
}
