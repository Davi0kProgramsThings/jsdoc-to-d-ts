ES2022 <: JSDOC {
    File = (Class | DocComment | ~Class ~DocComment any)*
    Class = DocComment? Export? "class" id "{" ClassBody "}"
    Export = "export" "default"?
    ClassBody = Method*
    Method = DocComment? "async"? id "(" ArgumentList ")" "{" (~"}" any)* "}"
    ArgumentList = ListOf<id, ",">
}
